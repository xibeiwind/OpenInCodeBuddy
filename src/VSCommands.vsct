<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <Extern href="stdidcmd.h"/>
    <Extern href="vsshlids.h"/>
    <Include href="KnownImageIds.vsct"/>

    <Commands package="guidPackage">
        <Buttons>
            <Button guid="guidOpenInCodeBuddyCmdSet" id="OpenInCodeBuddy" priority="0x0500" type="Button">
                <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_FOLDER_EXPLORE" />
                <Icon guid="guidImages" id="bmpCodeBuddy" />
                <Strings>
                    <ButtonText>Open in Code&amp;Buddy</ButtonText>
                </Strings>
            </Button>
            <Button guid="guidOpenCurrentInCodeBuddyCmdSet" id="OpenCurrentInCodeBuddy" priority="0x0500" type="Button">
                <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_FILEEDITVIEW" />
                <Icon guid="guidImages" id="bmpCodeBuddy" />
                <Strings>
                    <ButtonText>Open in Code&amp;Buddy</ButtonText>
                </Strings>
            </Button>
        </Buttons>

        <Bitmaps>
            <Bitmap guid="guidImages" href="Resources\Icon16.png" usedList="bmpCodeBuddy" />
        </Bitmaps>
    </Commands>

    <CommandPlacements>
        <CommandPlacement guid="guidOpenInCodeBuddyCmdSet" id="OpenInCodeBuddy" priority="0x0500">
            <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_SOLUTION_EXPLORE"/>
        </CommandPlacement>
        <CommandPlacement guid="guidOpenInCodeBuddyCmdSet" id="OpenInCodeBuddy" priority="0x0500">
            <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_PROJECT_EXPLORE"/>
        </CommandPlacement>
        <CommandPlacement guid="guidOpenInCodeBuddyCmdSet" id="OpenInCodeBuddy" priority="0x0500">
            <Parent guid="guidSHLMainMenu" id="IDG_VS_CTXT_ITEM_OPEN"/>
        </CommandPlacement>
    </CommandPlacements>

    <KeyBindings>
        <KeyBinding guid="guidOpenCurrentInCodeBuddyCmdSet" id="OpenCurrentInCodeBuddy" editor="guidVSStd97" key1="Y" mod1="Control Shift"/>
    </KeyBindings>

    <Symbols>
        <!-- This is the package guid. -->
        <GuidSymbol name="guidPackage" value="{ba91a506-66b2-4c81-8fd6-45b48f2143bf}" />

        <GuidSymbol name="guidOpenInCodeBuddyCmdSet" value="{c92ab33b-728b-44fd-8047-622b33518347}">
            <IDSymbol name="OpenInCodeBuddy" value="0x0100" />
        </GuidSymbol>
        <GuidSymbol name="guidOpenCurrentInCodeBuddyCmdSet" value="{7c05a8bb-7b98-46ee-a0d3-e56d5eeffc4f}">
            <IDSymbol name="OpenCurrentInCodeBuddy" value="0x0101" />
        </GuidSymbol>

        <GuidSymbol name="guidImages" value="{1b1bbc42-6d7c-4a71-bf82-d385f5e4abd8}">
            <IDSymbol name="bmpCodeBuddy" value="1" />
        </GuidSymbol>
    </Symbols>
</CommandTable>
